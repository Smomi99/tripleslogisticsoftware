# Copy to .env.production ON THE SERVER and fill in. Never commit the result —
# .gitignore already excludes .env.* for this reason.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# or, without node on the box:
#   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
# The apex. Workspaces live on subdomains of it: acme.example.com. Both this
# and *.this must have DNS A records pointing at the VPS.
APP_DOMAIN="example.com"

# Where Let's Encrypt sends expiry warnings. A real mailbox someone reads.
ACME_EMAIL="ops@example.com"

# Cloudflare API token with Zone:DNS:Edit on this zone only. Needed for the
# DNS-01 challenge, which is the only way to get a wildcard certificate.
CLOUDFLARE_API_TOKEN=""

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The OWNER role. Migrations run as this; the application must not.
POSTGRES_USER="ff_erp"
POSTGRES_PASSWORD=""
POSTGRES_DB="ff_erp"

# The RUNTIME role. §7A rule 2: a table owner bypasses row-level security, so
# the API connects as ff_app, which owns nothing. The migration creates the
# role NOLOGIN; the runbook gives it this password. Point the API at the owner
# instead and every tenant boundary in the product stops binding, silently.
FF_APP_PASSWORD=""

# ---------------------------------------------------------------------------
# Auth (CLAUDE.md §2)
# ---------------------------------------------------------------------------
# Two DIFFERENT secrets. Rotating either signs everyone out, which is the
# intended emergency response to a leak.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------
# LEAVE EMPTY on a VPS with wildcard DNS — that is the whole point of having
# bought one. The workspace then comes from the subdomain (§7A rule 5).
# Set it only to pin the entire server to a single workspace, and remember it
# is baked into the web image at build time, so changing it needs a rebuild.
DEFAULT_TENANT_SLUG=""

# ---------------------------------------------------------------------------
# Backups (deploy/backup.sh)
# ---------------------------------------------------------------------------
# An rclone remote for offsite copies, e.g. "r2:ff-erp-backups". Without it
# backups only survive problems that leave the VPS intact.
OFFSITE_REMOTE=""
BACKUP_DIR="/var/backups/ff-erp"
KEEP_DAYS="14"

# ---------------------------------------------------------------------------
# Outgoing mail (docs/DEPLOY_VPS.md)
# ---------------------------------------------------------------------------
# Nothing is sent unless HOST, USER and PASS are all set.
# Use an APP-SPECIFIC password, never the mailbox password: it can be revoked
# on its own, and it is the only secret in this file that another system holds
# a copy of.
SMTP_HOST="smtppro.zoho.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tsl.pricing@triplesbd.com"
SMTP_PASS=""
MAIL_FROM="tsl.pricing@triplesbd.com"

# Puts a link to the inquiry in the email.
APP_URL="https://acme.example.com"
