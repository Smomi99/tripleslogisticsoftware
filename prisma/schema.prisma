/// client: Table_Customer
model Customer {
  tenantId            BigInt       @map("tenant_id")
  id                  BigInt       @id @default(autoincrement())
  code                String       @db.VarChar(32)
  name                String       @db.VarChar(200)
  country             String       @db.VarChar(100)
  address             String?      @db.Text
  customerType        CustomerType @map("customer_type")
  businessArea        BusinessArea @map("business_area")
  industrySectorId    BigInt       @map("industry_sector_id")
  /// Export sea volume, TEU per month.
  exSeaVolumeTeuMonth Decimal?     @map("ex_sea_volume_teu_month") @db.Decimal(18, 4)
  /// Export air volume, KG per month.
  exAirVolumeKgMonth  Decimal?     @map("ex_air_volume_kg_month") @db.Decimal(18, 4)
  /// Import sea volume, TEU per month.
  imSeaVolumeTeuMonth Decimal?     @map("im_sea_volume_teu_month") @db.Decimal(18, 4)
  /// Import air volume, KG per month.
  imAirVolumeKgMonth  Decimal?     @map("im_air_volume_kg_month") @db.Decimal(18, 4)
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           BigInt?      @map("created_by")
  updatedBy           BigInt?      @map("updated_by")
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  industrySector IndustrySector @relation(fields: [tenantId, industrySectorId], references: [tenantId, id], onDelete: Restrict)

  pics CustomerPic[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([industrySectorId])
  @@index([name])
  @@index([country])
  @@index([customerType])
  @@index([businessArea])
  @@map("customer")
}

