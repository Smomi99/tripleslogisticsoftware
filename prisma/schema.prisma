/// client: Table_Employee  (1:1 CV screen)
model EmployeeCv {
  tenantId         BigInt    @map("tenant_id")
  id               BigInt    @id @default(autoincrement())
  employeeId       BigInt    @map("employee_id")
  presentAddress   String?   @map("present_address") @db.Text
  permanentAddress String?   @map("permanent_address") @db.Text
  qualification    String?   @db.Text
  fatherName       String?   @map("father_name") @db.VarChar(200)
  motherName       String?   @map("mother_name") @db.VarChar(200)
  siblingName      String?   @map("sibling_name") @db.VarChar(200)
  siblingMobile    String?   @map("sibling_mobile") @db.VarChar(50)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  reference1       String?   @map("reference_1") @db.Text
  reference2       String?   @map("reference_2") @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        BigInt?   @map("created_by")
  updatedBy        BigInt?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  // One CV per employee, and the composite the 1:1 relation resolves against.
  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("employee_cv")
}

/// client: Table_Employee  (1:1 Salary screen)
/// gross_salary is GENERATED ALWAYS in Postgres — added in migration SQL, and
/// left optional here so Prisma never writes to it (§6).
model EmployeeSalary {
  tenantId    BigInt    @map("tenant_id")
  id          BigInt    @id @default(autoincrement())
  employeeId  BigInt    @map("employee_id")
  basicSalary Decimal   @default(0) @map("basic_salary") @db.Decimal(18, 4)
  homeRent    Decimal   @default(0) @map("home_rent") @db.Decimal(18, 4)
  medical     Decimal   @default(0) @db.Decimal(18, 4)
  mobileBill  Decimal   @default(0) @map("mobile_bill") @db.Decimal(18, 4)
  insurance   Decimal   @default(0) @db.Decimal(18, 4)
  incentive   Decimal   @default(0) @db.Decimal(18, 4)
  /// Read-only. Sum of the six components above, computed by Postgres.
  grossSalary Decimal?  @map("gross_salary") @db.Decimal(18, 4)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   BigInt?   @map("created_by")
  updatedBy   BigInt?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  // One salary record per employee, and the composite the 1:1 resolves against.
  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("employee_salary")
}

// ===========================================================================
// §7 RBAC — included here because every table's created_by/updated_by needs
// `user` to exist, and user needs `role`. The permission *logic* is Phase 3;
// only the tables are defined now. See OPEN QUESTION 5.
// ===========================================================================

model Role {
  tenantId    BigInt    @map("tenant_id")
  id          BigInt    @id @default(autoincrement())
  code        String    @db.VarChar(32)
  name        String    @db.VarChar(100)
  description String?   @db.Text
  /// Seeded template role — cannot be deleted by the tenant.
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   BigInt?   @map("created_by")
  updatedBy   BigInt?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  tenantId     BigInt   @map("tenant_id")
  id           BigInt   @id @default(autoincrement())
  roleId       BigInt   @map("role_id")
  permissionId BigInt   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    BigInt?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission")
}

/// The auth account. §6 lists User under CRM with no wireframe; §7 gives its
/// fields. Linked to an employee record.
model User {
  tenantId     BigInt    @map("tenant_id")
  id           BigInt    @id @default(autoincrement())
  code         String    @db.VarChar(32)
  employeeId   BigInt?   @map("employee_id")
  username     String    @db.VarChar(100)
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  roleId       BigInt?   @map("role_id")
  /// Tenant-level superadmin: bypasses permissions, never plan limits (§7B).
  isSuperadmin Boolean   @default(false) @map("is_superadmin")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    BigInt?   @map("created_by")
  updatedBy    BigInt?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee? @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  role     Role?     @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  permissions UserPermission[]

  // §4 rule 9: scoped per tenant — two companies may employ the same person.
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([employeeId])
  @@index([roleId])
  @@map("user")
}

/// Per-user override on top of the role's permissions. DENY beats everything
/// except a superadmin (§7 resolution order).
model UserPermission {
  tenantId     BigInt           @map("tenant_id")
  id           BigInt           @id @default(autoincrement())
  userId       BigInt           @map("user_id")
  permissionId BigInt           @map("permission_id")
  effect       PermissionEffect
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    BigInt?          @map("created_by")
  updatedBy    BigInt?          @map("updated_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, permissionId])
  @@index([tenantId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permission")
}

// ===========================================================================
// §4 rule 7 — AUDIT TRAIL
// ===========================================================================

/// Written by Prisma middleware on every create / update / deactivate.
/// Columns are exactly those §4 rule 7 lists, plus tenant_id.
model AuditLog {
  tenantId  BigInt      @map("tenant_id")
  id        BigInt      @id @default(autoincrement())
  tableName String      @map("table_name") @db.VarChar(63)
  recordId  BigInt      @map("record_id")
  action    AuditAction
  /// Resolves which table changed_by refers to. See AuditActorType.
  actorType AuditActorType @default(USER) @map("actor_type")
  changedBy BigInt?     @map("changed_by")
  oldValues Json?       @map("old_values")
  newValues Json?       @map("new_values")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tableName, recordId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("audit_log")
}
