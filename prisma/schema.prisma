// ===========================================================================
// §4 rule 7 — AUDIT TRAIL
// ===========================================================================

/// Written by Prisma middleware on every create / update / deactivate.
/// Columns are exactly those §4 rule 7 lists, plus tenant_id.
model AuditLog {
  tenantId  BigInt         @map("tenant_id")
  id        BigInt         @id @default(autoincrement())
  tableName String         @map("table_name") @db.VarChar(63)
  recordId  BigInt         @map("record_id")
  action    AuditAction
  /// Resolves which table changed_by refers to. See AuditActorType.
  actorType AuditActorType @default(USER) @map("actor_type")
  changedBy BigInt?        @map("changed_by")
  oldValues Json?          @map("old_values")
  newValues Json?          @map("new_values")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, tableName, recordId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("audit_log")
}

// ===========================================================================
// PURCHASE & SALES lookups (docs/MODULE_PURCHASE_SALES.md §3.1)
//
// System-capable like every other lookup in the system (§7A rule 7): these are
// industry vocabularies — ISO container types, standard terms of shipment,
// cargo classifications — identical for every forwarder. NULL tenant_id is a
// shared row; a workspace may add its own alongside and switch a shared one off
// for itself, but never edit it.
//
// The spec writes "id, tenant_id" for these, which read literally would mean
// tenant-owned and a duplicate copy of the ISO container list per workspace.
// Following the established lookup pattern instead — see the report.
// ===========================================================================

enum RateMode {
  SEA_FCL
  SEA_LCL
  AIR

  @@map("rate_mode")
}

enum RateTierUnit {
  CONTAINER
  CBM
  KG

  @@map("rate_tier_unit")
}

/// spec: goods_type — how the cargo must be handled, not what industry it is
/// from. Distinct from industry_sector (Garments), which describes the customer.
model GoodsType {
  tenantId    BigInt?   @map("tenant_id")
  id          BigInt    @id @default(autoincrement())
  code        String    @db.VarChar(32)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   BigInt?   @map("created_by")
  updatedBy   BigInt?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByUser User?   @relation("GoodsTypeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?   @relation("GoodsTypeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  freightRates FreightRate[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([name])
  @@map("goods_type")
}

/// spec: container_type — teu_factor drives volume reporting (a 40ft is 2 TEU).
model ContainerType {
  tenantId  BigInt?   @map("tenant_id")
  id        BigInt    @id @default(autoincrement())
  code      String    @db.VarChar(32)
  name      String    @db.VarChar(200)
  /// 20STD = 1.00, 40STD/40HC = 2.00, 45FT = 2.25
  teuFactor Decimal   @default(1) @map("teu_factor") @db.Decimal(4, 2)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByUser User?   @relation("ContainerTypeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?   @relation("ContainerTypeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  rateTiers      RateTier[]
  inquiryVolumes InquiryVolume[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("container_type")
}

/// spec §2: the tier definitions. This table is why the four wireframe columns
/// are rows — an airline contract needing MIN/-45/+45 is a seed row here rather
/// than a migration and a UI rewrite.
model RateTier {
  tenantId        BigInt?      @map("tenant_id")
  id              BigInt       @id @default(autoincrement())
  code            String       @db.VarChar(32)
  mode            RateMode
  label           String       @db.VarChar(100)
  unit            RateTierUnit
  /// Bracket bounds, e.g. LCL 5–10 CBM. NULL max = open-ended ("15+").
  minValue        Decimal?     @map("min_value") @db.Decimal(18, 3)
  maxValue        Decimal?     @map("max_value") @db.Decimal(18, 3)
  sortOrder       Int          @default(0) @map("sort_order")
  /// SEA_FCL tiers are a container type; LCL and AIR tiers are weight/volume
  /// brackets and leave this null.
  containerTypeId BigInt?      @map("container_type_id")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       BigInt?      @map("created_by")
  updatedBy       BigInt?      @map("updated_by")
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  containerType ContainerType? @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
  createdByUser User?          @relation("RateTierCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?          @relation("RateTierUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  rateLines FreightRateLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([mode, sortOrder])
  @@map("rate_tier")
}

/// spec: tos — Terms of Shipment (CY/CY, Door/Door …).
model Tos {
  tenantId  BigInt?   @map("tenant_id")
  id        BigInt    @id @default(autoincrement())
  code      String    @db.VarChar(32)
  name      String    @db.VarChar(200)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByUser User?     @relation("TosCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?     @relation("TosUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  inquiries     Inquiry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tos")
}

/// spec: inquiry_source — where the inquiry came from.
model InquirySource {
  tenantId  BigInt?   @map("tenant_id")
  id        BigInt    @id @default(autoincrement())
  code      String    @db.VarChar(32)
  name      String    @db.VarChar(200)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByUser User?     @relation("InquirySourceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?     @relation("InquirySourceUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  inquiries     Inquiry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("inquiry_source")
}

// ===========================================================================
// PURCHASE — rate tables (docs/MODULE_PURCHASE_SALES.md §3.2)
//
// Tenant-owned, all of them: a bought rate is one forwarder's commercial
// position and is never shared.
//
// §4 rule 1 is the load-bearing rule here — rates are versioned, never
// overwritten. Editing a rate supersedes it: the current row's valid_to moves
// to yesterday, its status goes EXPIRED, superseded_by_id points at the
// replacement. A quotation issued last month must still resolve to the rate
// that was live when it was issued.
// ===========================================================================

/// Which master "Purchase via" points at (§9 Q3, answered: all three).
enum PurchaseSourceType {
  CARRIER
  VENDOR
  AGENT

  @@map("purchase_source_type")
}

/// §4 rule 3 — EXPIRED is set by the nightly job, never by hand.
enum RateStatus {
  DRAFT
  PUBLISHED
  EXPIRED

  @@map("rate_status")
}

/// The client asked for both margin methods, chosen per rate line.
enum ProfitType {
  FLAT
  PERCENT

  @@map("profit_type")
}

/// Which end of the lane a local charge sits at.
enum ChargeSide {
  POL
  POD

  @@map("charge_side")
}

/// spec §3.2: freight_rate — one bought rate for one lane, carrier and period.
model FreightRate {
  tenantId    BigInt   @map("tenant_id")
  id          BigInt   @id @default(autoincrement())
  code        String   @db.VarChar(32)
  mode        RateMode
  /// AOL when mode = AIR. §4 rule 9 constrains the port type server-side.
  polId       BigInt   @map("pol_id")
  /// AOD when mode = AIR.
  podId       BigInt   @map("pod_id")
  carrierId   BigInt   @map("carrier_id")
  goodsTypeId BigInt   @map("goods_type_id")

  /// "Purchase via" (§9 Q3). The spec writes a polymorphic purchase_source_id,
  /// which cannot carry a foreign key and so cannot satisfy §4 rule 5. Three
  /// nullable typed columns instead, with a CHECK that exactly one is set and
  /// agrees with purchase_source_type — same expressiveness, real integrity.
  purchaseSourceType PurchaseSourceType @map("purchase_source_type")
  purchaseCarrierId  BigInt?            @map("purchase_carrier_id")
  purchaseVendorId   BigInt?            @map("purchase_vendor_id")
  purchaseAgentId    BigInt?            @map("purchase_agent_id")

  /// §9 Q4: any currency, USD the default. §4 rule 6 — currency beside amount.
  currencyId  BigInt     @map("currency_id")
  validFrom   DateTime   @map("valid_from") @db.Date
  validTo     DateTime   @map("valid_to") @db.Date
  transitDays Int?       @map("transit_days")
  /// §9 Q13, answered: free days at destination before demurrage starts. Sales
  /// are asked this on every call, and backfilling it would mean re-entering
  /// every rate already keyed in.
  freeDays    Int?       @map("free_days")
  remarks     String?    @db.Text
  status      RateStatus @default(DRAFT)

  /// §4 rule 1: set on the old row when a replacement supersedes it, so the
  /// version chain is walkable in both directions.
  supersededById BigInt? @map("superseded_by_id")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Port, carrier, goods type and currency are system-capable, so a shared row
  // has tenant_id NULL and a composite tenant FK cannot resolve. Single-column
  // FKs, with tenant scoping enforced by the Prisma extension and RLS — the
  // same shape carrier_service_port already uses.
  pol       Port      @relation("FreightRatePol", fields: [polId], references: [id], onDelete: Restrict)
  pod       Port      @relation("FreightRatePod", fields: [podId], references: [id], onDelete: Restrict)
  carrier   Carrier   @relation("FreightRateCarrier", fields: [carrierId], references: [id], onDelete: Restrict)
  goodsType GoodsType @relation(fields: [goodsTypeId], references: [id], onDelete: Restrict)
  currency  Currency  @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  // Vendor and agent are tenant-owned, so these get the composite tenant-safe
  // FK §4 rule 10 asks for.
  purchaseCarrier Carrier? @relation("FreightRatePurchaseCarrier", fields: [purchaseCarrierId], references: [id], onDelete: Restrict)
  purchaseVendor  Vendor?  @relation(fields: [tenantId, purchaseVendorId], references: [tenantId, id], onDelete: Restrict)
  purchaseAgent   Agent?   @relation(fields: [tenantId, purchaseAgentId], references: [tenantId, id], onDelete: Restrict)

  supersededBy FreightRate?  @relation("FreightRateSupersede", fields: [tenantId, supersededById], references: [tenantId, id], onDelete: Restrict)
  supersedes   FreightRate[] @relation("FreightRateSupersede")

  createdByUser User? @relation("FreightRateCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("FreightRateUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  lines        FreightRateLine[]
  localCharges RateLocalCharge[]
  inquiryRates InquiryRate[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  // The Price List's default query: this lane, this mode, still valid.
  @@index([tenantId, mode, polId, podId, validTo])
  @@index([tenantId, status, validTo])
  @@index([carrierId])
  @@index([goodsTypeId])
  @@map("freight_rate")
}

/// spec §3.2: freight_rate_line — the price for one tier of one rate.
model FreightRateLine {
  tenantId BigInt @map("tenant_id")
  id       BigInt @id @default(autoincrement())
  rateId   BigInt @map("rate_id")
  tierId   BigInt @map("tier_id")

  /// §4 rule 5: restricted. Stripped from the API response, not just hidden.
  buyPrice    Decimal    @map("buy_price") @db.Decimal(18, 4)
  profitType  ProfitType @default(FLAT) @map("profit_type")
  profitValue Decimal    @default(0) @map("profit_value") @db.Decimal(18, 4)

  /// §4 rule 4: read-only, computed by Postgres. Never written by hand, never
  /// computed in the API or the browser. The migration installs it as
  /// GENERATED ALWAYS ... STORED.
  sellPrice Decimal? @default(dbgenerated()) @map("sell_price") @db.Decimal(18, 4)

  /// §9 Q6, answered yes: the floor this line bills at — LCL's minimum CBM,
  /// air's MIN charge below the first weight break. Null means no floor.
  minCharge Decimal? @map("min_charge") @db.Decimal(18, 4)

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rate   FreightRate @relation(fields: [tenantId, rateId], references: [tenantId, id], onDelete: Restrict)
  tier   RateTier    @relation(fields: [tierId], references: [id], onDelete: Restrict)

  createdByUser User? @relation("FreightRateLineCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("FreightRateLineUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  profitLog    RateProfitLog[]
  inquiryRates InquiryRate[]

  @@unique([tenantId, rateId, tierId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([rateId])
  @@index([tierId])
  @@map("freight_rate_line")
}

/// spec §3.2: rate_local_charge — "POL Local Charges", broken down by cost
/// head rather than a lump sum (§9 Q2, answered).
model RateLocalCharge {
  tenantId   BigInt     @map("tenant_id")
  id         BigInt     @id @default(autoincrement())
  rateId     BigInt     @map("rate_id")
  costHeadId BigInt     @map("cost_head_id")
  side       ChargeSide
  amount     Decimal    @db.Decimal(18, 4)

  /// §9 Q2: local charges may sit in BDT while the freight is in USD, so this
  /// is the charge's own currency, not the rate's.
  currencyId BigInt @map("currency_id")

  /// Copied from the cost head at entry rather than joined at read time — if
  /// the cost head's unit is later corrected, a rate agreed under the old unit
  /// must not silently change meaning.
  costUnitId BigInt? @map("cost_unit_id")

  remarks   String?   @db.Text
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rate     FreightRate @relation(fields: [tenantId, rateId], references: [tenantId, id], onDelete: Restrict)
  costHead CostHead    @relation(fields: [tenantId, costHeadId], references: [tenantId, id], onDelete: Restrict)
  currency Currency    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  costUnit CostUnit?   @relation(fields: [costUnitId], references: [id], onDelete: Restrict)

  createdByUser User? @relation("RateLocalChargeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("RateLocalChargeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, rateId, costHeadId, side])
  @@index([tenantId])
  @@index([rateId])
  @@index([costHeadId])
  @@map("rate_local_charge")
}

/// spec §3.2: rate_profit_log — who changed a margin, when, and from what
/// (§4 rule 6). Append-only, so it follows the audit_log shape rather than the
/// §4 rule 2 master-table shape: no code, no is_active, no soft delete.
model RateProfitLog {
  tenantId       BigInt      @map("tenant_id")
  id             BigInt      @id @default(autoincrement())
  rateLineId     BigInt      @map("rate_line_id")
  oldProfitType  ProfitType? @map("old_profit_type")
  oldProfitValue Decimal?    @map("old_profit_value") @db.Decimal(18, 4)
  newProfitType  ProfitType  @map("new_profit_type")
  newProfitValue Decimal     @map("new_profit_value") @db.Decimal(18, 4)
  reason         String?     @db.Text
  changedBy      BigInt?     @map("changed_by")
  changedAt      DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rateLine      FreightRateLine @relation(fields: [tenantId, rateLineId], references: [tenantId, id], onDelete: Restrict)
  changedByUser User?           @relation("RateProfitLogChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([rateLineId])
  @@index([changedAt])
  @@map("rate_profit_log")
}

// ===========================================================================
// SALES — inquiry (docs/MODULE_PURCHASE_SALES.md §3.3)
//
// All tenant-owned. An inquiry is one customer's request on one lane, and the
// numbers the business is measured on — won, lost, quoted — hang off its status.
// ===========================================================================

enum ShipmentType {
  SEA
  AIR

  @@map("shipment_type")
}

/// §3.3's movement_type. Deliberately not customer.business_area, which is the
/// same words over a different set — that one also allows BOTH.
enum MovementType {
  INBOUND
  OUTBOUND

  @@map("movement_type")
}

/// §9 Q10, answered: this list is right. EXPIRED is set by §4 rule 11's
/// auto-expiry; WON and LOST need their own permission.
enum InquiryStatus {
  OPEN
  QUOTED
  WON
  LOST
  EXPIRED
  CANCELLED

  @@map("inquiry_status")
}

/// Which shape a volume row takes — §5.4's grid renders rows by shipment type.
enum VolumeKind {
  FCL
  LCL
  AIR

  @@map("volume_kind")
}

enum ContactMode {
  CALL
  EMAIL
  VISIT
  WHATSAPP

  @@map("contact_mode")
}

/// §9 Q12, answered "separate table": a lead is a conversation before there is
/// a lane, and an inquiry links back to the one it came from.
///
/// SKELETON ONLY. CLAUDE.md §3 lists "New Sales Lead" and "Sales Lead
/// Follow-up" with no wireframe, so its business fields are unspecified and are
/// NOT invented here — see §11. The table exists now because Q12's answer makes
/// inquiry.lead_id worth having from the start: adding that link after
/// inquiries exist means guessing which lead each came from. The lead screens
/// stay unbuilt until a field list arrives.
model SalesLead {
  tenantId  BigInt    @map("tenant_id")
  id        BigInt    @id @default(autoincrement())
  code      String    @db.VarChar(32)
  /// The company or person the conversation is with. The only business field
  /// safe to assume; everything else awaits the wireframe.
  name      String    @db.VarChar(200)
  notes     String?   @db.Text
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByUser User?  @relation("SalesLeadCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?  @relation("SalesLeadUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  followups SalesLeadFollowup[]
  inquiries Inquiry[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("sales_lead")
}

/// spec §3.3: inquiry.
///
/// `code` IS the client's inquiry_no — one column, not two. §9 Q9, answered:
/// INQ-2026-000001, per tenant per year, restarting each January. That yearly
/// reset is why the shared nextCode helper cannot generate it; see lib/inquiry-no.
model Inquiry {
  tenantId    BigInt   @map("tenant_id")
  id          BigInt   @id @default(autoincrement())
  /// The client's Inquiry No, e.g. INQ-2026-000001.
  code        String   @db.VarChar(32)
  /// Held alongside code so the yearly series can be queried without parsing.
  seriesYear  Int      @map("series_year")
  inquiryDate DateTime @map("inquiry_date") @db.Date

  sourceId        BigInt       @map("source_id")
  shipmentType    ShipmentType @map("shipment_type")
  customerId      BigInt       @map("customer_id")
  movementType    MovementType @map("movement_type")
  polId           BigInt       @map("pol_id")
  podId           BigInt       @map("pod_id")
  placeOfReceipt  String?      @map("place_of_receipt") @db.Text
  commodityItemId BigInt?      @map("commodity_item_id")
  /// §5.4: prefilled from the commodity, then editable — so it is stored, not
  /// joined. A corrected commodity must not rewrite an inquiry already sent.
  hsCode          String?      @map("hs_code") @db.VarChar(50)
  tosId           BigInt?      @map("tos_id")

  targetPrice Decimal? @map("target_price") @db.Decimal(18, 4)
  currencyId  BigInt?  @map("currency_id")

  expectedShipmentDate DateTime? @map("expected_shipment_date") @db.Date
  /// "Inquiry Valid Upto". §4 rule 11 auto-expires an OPEN inquiry past this.
  validTo              DateTime? @map("valid_to") @db.Date
  weightKg             Decimal?  @map("weight_kg") @db.Decimal(18, 3)
  remarks              String?   @db.Text

  salesmanId BigInt?       @map("salesman_id")
  status     InquiryStatus @default(OPEN)

  /// §9 Q12: the lead this came from, when it came from one.
  leadId BigInt? @map("lead_id")

  /// Written back by §5.5's Price action from the attached rates.
  quotedPrice Decimal? @map("quoted_price") @db.Decimal(18, 4)

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // System-capable targets take single-column FKs: a shared row has a null
  // tenant_id, and a composite tenant FK cannot resolve against it.
  source   InquirySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  pol      Port          @relation("InquiryPol", fields: [polId], references: [id], onDelete: Restrict)
  pod      Port          @relation("InquiryPod", fields: [podId], references: [id], onDelete: Restrict)
  tos      Tos?          @relation(fields: [tosId], references: [id], onDelete: Restrict)
  currency Currency?     @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  // Tenant-owned targets take the composite tenant-safe FK (§4 rule 10).
  customer      Customer       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  commodityItem CommodityItem? @relation(fields: [tenantId, commodityItemId], references: [tenantId, id], onDelete: Restrict)
  salesman      Employee?      @relation(fields: [tenantId, salesmanId], references: [tenantId, id], onDelete: Restrict)
  lead          SalesLead?     @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)

  createdByUser User? @relation("InquiryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("InquiryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  volumes   InquiryVolume[]
  followups InquiryFollowup[]
  rates     InquiryRate[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  // §5.5's filter set: date range, shipment type, lane, salesman, status.
  @@index([tenantId, status, inquiryDate])
  @@index([tenantId, salesmanId])
  // §9 Q9: the Inquiry No restarts each January, so generating the next one
  // in a year is a lookup on this. Declared here, not in an appendix — an
  // index Prisma does not know about gets dropped by the next migration.
  @@index([tenantId, seriesYear, code])
  @@index([customerId])
  @@index([polId])
  @@index([podId])
  @@map("inquiry")
}

/// spec §3.3: inquiry_volume — §5.4's "small grid, not six loose inputs".
model InquiryVolume {
  tenantId        BigInt     @map("tenant_id")
  id              BigInt     @id @default(autoincrement())
  inquiryId       BigInt     @map("inquiry_id")
  volumeKind      VolumeKind @map("volume_kind")
  /// Set for FCL rows, null for the single LCL or Air row.
  containerTypeId BigInt?    @map("container_type_id")
  quantity        Int?
  cbm             Decimal?   @db.Decimal(18, 3)
  weightKg        Decimal?   @map("weight_kg") @db.Decimal(18, 3)

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inquiry       Inquiry        @relation(fields: [tenantId, inquiryId], references: [tenantId, id], onDelete: Restrict)
  containerType ContainerType? @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)

  createdByUser User? @relation("InquiryVolumeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("InquiryVolumeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([inquiryId])
  @@map("inquiry_volume")
}

/// spec §3.3: inquiry_followup — drives §5.5's "Follow Up(n)" counter.
model InquiryFollowup {
  tenantId         BigInt      @map("tenant_id")
  id               BigInt      @id @default(autoincrement())
  inquiryId        BigInt      @map("inquiry_id")
  followupDate     DateTime    @map("followup_date") @db.Date
  contactMode      ContactMode @map("contact_mode")
  contactPerson    String?     @map("contact_person") @db.VarChar(200)
  notes            String?     @db.Text
  nextFollowupDate DateTime?   @map("next_followup_date") @db.Date

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inquiry Inquiry @relation(fields: [tenantId, inquiryId], references: [tenantId, id], onDelete: Restrict)

  createdByUser User? @relation("InquiryFollowupCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("InquiryFollowupUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([inquiryId])
  @@index([nextFollowupDate])
  @@map("inquiry_followup")
}

/// spec §3.3: inquiry_rate — §5.5's Price action, attaching rates to an inquiry.
model InquiryRate {
  tenantId    BigInt   @map("tenant_id")
  id          BigInt   @id @default(autoincrement())
  inquiryId   BigInt   @map("inquiry_id")
  rateId      BigInt   @map("rate_id")
  rateLineId  BigInt   @map("rate_line_id")
  /// The figure quoted from this line, captured when it was attached.
  /// Snapshotted rather than joined: §4 rule 1 versions rates, so by the time
  /// anyone reads this back the live line may belong to a superseded rate.
  quotedPrice Decimal  @map("quoted_price") @db.Decimal(18, 4)
  isSelected  Boolean  @default(false) @map("is_selected")
  addedBy     BigInt?  @map("added_by")
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inquiry  Inquiry         @relation(fields: [tenantId, inquiryId], references: [tenantId, id], onDelete: Restrict)
  rate     FreightRate     @relation(fields: [tenantId, rateId], references: [tenantId, id], onDelete: Restrict)
  rateLine FreightRateLine @relation(fields: [tenantId, rateLineId], references: [tenantId, id], onDelete: Restrict)

  addedByUser   User? @relation("InquiryRateAddedBy", fields: [addedBy], references: [id], onDelete: Restrict)
  createdByUser User? @relation("InquiryRateCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("InquiryRateUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, inquiryId, rateLineId])
  @@index([tenantId])
  @@index([inquiryId])
  @@index([rateId])
  @@map("inquiry_rate")
}

/// Follow-ups against a lead — CLAUDE.md §3's "Sales Lead Follow-up" screen.
///
/// The spec defines no shape for this. It is a deliberate mirror of
/// inquiry_followup, which the spec DOES define, pointed at a lead instead of
/// an inquiry — not a new design. If the client's wireframe turns out to want
/// different fields, this is the table to change, and nothing else depends on
/// its columns.
model SalesLeadFollowup {
  tenantId         BigInt      @map("tenant_id")
  id               BigInt      @id @default(autoincrement())
  leadId           BigInt      @map("lead_id")
  followupDate     DateTime    @map("followup_date") @db.Date
  contactMode      ContactMode @map("contact_mode")
  contactPerson    String?     @map("contact_person") @db.VarChar(200)
  notes            String?     @db.Text
  nextFollowupDate DateTime?   @map("next_followup_date") @db.Date

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?   @map("created_by")
  updatedBy BigInt?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead   SalesLead @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)

  createdByUser User? @relation("SalesLeadFollowupCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("SalesLeadFollowupUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([leadId])
  @@index([nextFollowupDate])
  @@map("sales_lead_followup")
}
