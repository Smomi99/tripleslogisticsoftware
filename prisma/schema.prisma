/// client: Table_Employee
model Employee {
  tenantId            BigInt    @map("tenant_id")
  id                  BigInt    @id @default(autoincrement())
  code                String    @db.VarChar(32)
  name                String    @db.VarChar(200)
  country             String    @db.VarChar(100)
  department          String?   @db.VarChar(100)
  designation         String?   @db.VarChar(100)
  joiningDate         DateTime? @map("joining_date") @db.Date
  officeMobile        String?   @map("office_mobile") @db.VarChar(50)
  personalEmail       String?   @map("personal_email") @db.VarChar(255)
  qualification       String?   @db.Text
  /// Storage key only, never the file itself (§2).
  serviceContractFile String?   @map("service_contract_file") @db.VarChar(500)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           BigInt?   @map("created_by")
  updatedBy           BigInt?   @map("updated_by")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  cv     EmployeeCv?
  salary EmployeeSalary?
  users  User[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([name])
  @@index([department])
  @@map("employee")
