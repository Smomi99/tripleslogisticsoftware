# Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Owner connection — used by `prisma migrate` / `prisma studio` only.
DATABASE_URL="postgresql://ff_erp:ff_erp_dev@localhost:5432/ff_erp?schema=public"

# Runtime connection used by the API — the ff_app role.
# CLAUDE.md §7A rule 2: a table OWNER bypasses RLS, so the API must NOT connect
# as ff_erp. ff_app owns nothing, which is what makes the policies bind. Point
# this back at ff_erp and every tenant boundary silently disappears.
# Create the local login once with: pnpm db:app-role
DATABASE_URL_APP="postgresql://ff_app:ff_app_dev@localhost:5432/ff_erp?schema=public"

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
API_PORT=4000
NODE_ENV=development

# Origin allowed to send credentialed requests (the Next.js app).
WEB_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth — CLAUDE.md §2. Placeholders; wired up in Phase 3.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---------------------------------------------------------------------------
# Files — CLAUDE.md §2: local disk in dev, S3-compatible in prod.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# Permissions and the system lookup values are always seeded. This additionally
# creates the "demo" workspace and a superadmin — local development only.
SEED_DEV_TENANT=true
# Password for that seeded superadmin. Change it, or set it per machine.
SEED_SUPERADMIN_PASSWORD="ChangeMe!2026"

# Local only: the browser has no subdomain on localhost, so this names the
# workspace. In production proxy.ts derives it from the host.
NEXT_PUBLIC_DEV_TENANT_SLUG="demo"

# ---------------------------------------------------------------------------
# Deployment (docs/DEPLOY.md) — unset locally, set on the host.
# ---------------------------------------------------------------------------
# Pins the deployment to ONE workspace, by slug. §7A rule 5 addresses a tenant
# by subdomain, which needs wildcard DNS — a paid feature on every free host.
# Set BOTH of these to the same slug, or the top bar labels a workspace the API
# is not serving. Unset them the moment wildcard DNS exists.
# DEFAULT_TENANT_SLUG="demo"
# NEXT_PUBLIC_TENANT_SLUG="demo"

# Where the web app proxies /api/* to. Setting this keeps the browser talking
# to one origin, so the SameSite=Lax refresh cookie is still sent. Leave unset
# in development, where NEXT_PUBLIC_API_URL addresses the API directly.
# API_ORIGIN="https://ff-erp-api.vercel.app"

# S3-compatible object storage — required when STORAGE_DRIVER=s3, which every
# serverless or ephemeral host needs, since their disks do not survive a
# restart. S3_ENDPOINT is required for Cloudflare R2, MinIO and Backblaze, and
# must be left unset for real AWS S3.
# S3_BUCKET="ff-erp-files"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
