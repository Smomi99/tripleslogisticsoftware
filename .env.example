# Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Owner connection — used by `prisma migrate` / `prisma studio` only.
DATABASE_URL="postgresql://ff_erp:ff_erp_dev@localhost:5432/ff_erp?schema=public"

# Runtime connection used by the API.
# CLAUDE.md §7A rule 2: a table OWNER bypasses RLS. Before RLS lands in Phase 2
# this must become a separate, non-owner role (or every tenant table must be
# declared FORCE ROW LEVEL SECURITY). Kept identical for now so Phase 0 runs.
DATABASE_URL_APP="postgresql://ff_erp:ff_erp_dev@localhost:5432/ff_erp?schema=public"

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
API_PORT=4000
NODE_ENV=development

# Origin allowed to send credentialed requests (the Next.js app).
WEB_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth — CLAUDE.md §2. Placeholders; wired up in Phase 3.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---------------------------------------------------------------------------
# Files — CLAUDE.md §2: local disk in dev, S3-compatible in prod.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
