# Caddy — TLS, and the one place that knows the API is a separate process.
#
# Two things here are load-bearing for the application, not just for routing:
#
#   1. /api/* is served from the SAME hostname as the app. The refresh token is
#      an httpOnly SameSite=Lax cookie (CLAUDE.md §2), and Lax means the
#      browser withholds it from cross-site requests — so an API on its own
#      subdomain would sign users in and then silently fail to refresh fifteen
#      minutes later. Same host, one origin, no CORS.
#
#   2. The Host header is passed through untouched. Both apps read the tenant
#      from the subdomain (§7A rule 5), so rewriting Host — which nginx does by
#      default and Caddy does not — would send every workspace to the same
#      tenant, or to none.

{
	email {$ACME_EMAIL}
}

# The wildcard covers every workspace: acme.example.com, globex.example.com.
# Adding a tenant is a database row, not a deployment.
*.{$APP_DOMAIN}, {$APP_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	# Order matters: the API path is matched before the catch-all.
	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
